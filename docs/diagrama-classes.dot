digraph UML {
rankdir=BT; nodesep=0.35; ranksep=0.7; newrank=true;
node [shape=plaintext fontname="DejaVu Sans" fontsize=10];
edge [fontname="DejaVu Sans" fontsize=9];
label="Diagrama de Classes - RPG de Console (POO + SOLID)"; labelloc=t; fontsize=18; fontname="DejaVu Sans Bold";
subgraph cluster_0 { label="pacote personagens"; style="rounded,dashed"; color="#888888"; fontsize=12; fontname="DejaVu Sans";
"Combatente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f0fe"><TR><TD><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>Combatente</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNome(): String<BR ALIGN='LEFT'/>+ getVida(): int<BR ALIGN='LEFT'/>+ getVidaMaxima(): int<BR ALIGN='LEFT'/>+ getAtaque(): int<BR ALIGN='LEFT'/>+ getDefesa(): int<BR ALIGN='LEFT'/>+ estaVivo(): boolean<BR ALIGN='LEFT'/>+ receberDano(dano: int): void<BR ALIGN='LEFT'/>+ atacar(alvo: Combatente, calc: CalculadoraDeDano): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Curavel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f0fe"><TR><TD><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>Curavel</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ curar(quantidade: int): int<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"UsaHabilidade" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f0fe"><TR><TD><FONT POINT-SIZE="9">«interface»</FONT><BR/><I><B>UsaHabilidade</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNomeHabilidade(): String<BR ALIGN='LEFT'/>+ getRecargaRestante(): int<BR ALIGN='LEFT'/>+ habilidadePronta(): boolean<BR ALIGN='LEFT'/>+ usarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/>+ avancarTurno(): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Personagem" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff4e5"><TR><TD><I><B>Personagem</B></I><BR/><FONT POINT-SIZE="9">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nome: String<BR ALIGN='LEFT'/>- vidaMaxima: int<BR ALIGN='LEFT'/>- vida: int<BR ALIGN='LEFT'/>- ataque: int<BR ALIGN='LEFT'/>- defesa: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ (métodos de Combatente)<BR ALIGN='LEFT'/># definirVida(novaVida: int): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Heroi" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff4e5"><TR><TD><I><B>Heroi</B></I><BR/><FONT POINT-SIZE="9">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- inventario: Inventario<BR ALIGN='LEFT'/>- arma: Arma<BR ALIGN='LEFT'/>- armadura: Armadura<BR ALIGN='LEFT'/>- nomeHabilidade: String<BR ALIGN='LEFT'/>- recargaMaxima: int<BR ALIGN='LEFT'/>- recargaRestante: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getClasse(): String {abstract}<BR ALIGN='LEFT'/># executarHabilidade(alvo, calc): String {abstract}<BR ALIGN='LEFT'/>+ getAtaque(): int<BR ALIGN='LEFT'/>+ getDefesa(): int<BR ALIGN='LEFT'/>+ curar(quantidade: int): int<BR ALIGN='LEFT'/>+ getNomeHabilidade(): String<BR ALIGN='LEFT'/>+ getRecargaRestante(): int<BR ALIGN='LEFT'/>+ habilidadePronta(): boolean<BR ALIGN='LEFT'/>+ usarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/>+ avancarTurno(): void<BR ALIGN='LEFT'/>+ getInventario(): Inventario<BR ALIGN='LEFT'/>+ getArma(): Arma<BR ALIGN='LEFT'/>+ getArmadura(): Armadura<BR ALIGN='LEFT'/>+ equiparArma(a: Arma): Arma<BR ALIGN='LEFT'/>+ equiparArmadura(a: Armadura): Armadura<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Guerreiro" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>Guerreiro</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getClasse(): String<BR ALIGN='LEFT'/># executarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Mago" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>Mago</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getClasse(): String<BR ALIGN='LEFT'/># executarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Arqueiro" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>Arqueiro</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getClasse(): String<BR ALIGN='LEFT'/># executarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Inimigo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff4e5"><TR><TD><I><B>Inimigo</B></I><BR/><FONT POINT-SIZE="9">{abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- recompensa: Item<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agir(alvo: Combatente, calc): String<BR ALIGN='LEFT'/>+ getRecompensa(): Item<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Goblin" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>Goblin</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Goblin(recompensa: Item)<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"Esqueleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>Esqueleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Esqueleto(recompensa: Item)<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
"ChefeDragao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD><B>ChefeDragao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- RECARGA_SOPRO: int = 3<BR ALIGN='LEFT'/>- recargaRestante: int<BR ALIGN='LEFT'/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agir(alvo, calc): String<BR ALIGN='LEFT'/>+ getNomeHabilidade(): String<BR ALIGN='LEFT'/>+ getRecargaRestante(): int<BR ALIGN='LEFT'/>+ habilidadePronta(): boolean<BR ALIGN='LEFT'/>+ usarHabilidade(alvo, calc): String<BR ALIGN='LEFT'/>+ avancarTurno(): void<BR ALIGN='LEFT'/></TD></TR></TABLE>>];
